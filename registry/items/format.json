{
  "name": "format",
  "type": "ui",
  "description": "Locale-aware formatting helpers from Ark, wrapping `Intl`.",
  "ark": "Format",
  "exports": [
    "FormatByte",
    "FormatNumber",
    "FormatRelativeTime",
    "FormatTime"
  ],
  "parts": [
    {
      "name": "FormatByte",
      "props": [
        {
          "name": "value",
          "type": "number",
          "required": true,
          "description": "The byte size to format",
          "from": "@ark-ui/react"
        },
        {
          "name": "unit",
          "type": "\"bit\" | \"byte\"",
          "required": false,
          "description": "The unit granularity to display",
          "from": "@ark-ui/react"
        },
        {
          "name": "unitDisplay",
          "type": "\"long\" | \"short\" | \"narrow\"",
          "required": false,
          "description": "The unit display",
          "from": "@ark-ui/react"
        },
        {
          "name": "unitSystem",
          "type": "\"decimal\" | \"binary\"",
          "required": false,
          "description": "The unit system to use for formatting",
          "from": "@ark-ui/react"
        }
      ]
    },
    {
      "name": "FormatNumber",
      "props": [
        {
          "name": "value",
          "type": "number",
          "required": true,
          "description": "The number to format",
          "from": "@ark-ui/react"
        },
        {
          "name": "style",
          "type": "keyof NumberFormatOptionsStyleRegistry",
          "required": false,
          "description": "Inline styles applied to the rendered element.",
          "from": "typescript"
        }
      ]
    },
    {
      "name": "FormatRelativeTime",
      "props": [
        {
          "name": "value",
          "type": "Date",
          "required": true,
          "description": "The date to format",
          "from": "@ark-ui/react"
        },
        {
          "name": "style",
          "type": "RelativeTimeFormatStyle",
          "required": false,
          "description": "The length of the internationalized message.",
          "from": "typescript"
        }
      ]
    },
    {
      "name": "FormatTime",
      "props": [
        {
          "name": "value",
          "type": "string | Date",
          "required": true,
          "description": "The time to format",
          "from": "@ark-ui/react"
        },
        {
          "name": "amLabel",
          "type": "string",
          "required": false,
          "from": "@zag-js/i18n-utils"
        },
        {
          "name": "format",
          "type": "TimeFormat",
          "required": false,
          "from": "@zag-js/i18n-utils"
        },
        {
          "name": "pmLabel",
          "type": "string",
          "required": false,
          "from": "@zag-js/i18n-utils"
        },
        {
          "name": "withSeconds",
          "type": "boolean",
          "required": false,
          "from": "@zag-js/i18n-utils"
        }
      ]
    }
  ],
  "dependencies": {
    "@ark-ui/react": "^5.39.1"
  },
  "registryDependencies": [],
  "files": [
    {
      "path": "components/ui/format.tsx",
      "content": "import * as React from \"react\"\nimport { Format as FormatPrimitive } from \"@ark-ui/react\"\n\n/** Locale-aware formatting helpers from Ark, wrapping `Intl`. */\n\nfunction FormatNumber({ ...props }: React.ComponentProps<typeof FormatPrimitive.Number>) {\n  return <FormatPrimitive.Number {...props} />\n}\n\nfunction FormatByte({ ...props }: React.ComponentProps<typeof FormatPrimitive.Byte>) {\n  return <FormatPrimitive.Byte {...props} />\n}\n\nfunction FormatTime({ ...props }: React.ComponentProps<typeof FormatPrimitive.Time>) {\n  return <FormatPrimitive.Time {...props} />\n}\n\nfunction FormatRelativeTime({ ...props }: React.ComponentProps<typeof FormatPrimitive.RelativeTime>) {\n  return <FormatPrimitive.RelativeTime {...props} />\n}\n\nexport { FormatByte, FormatNumber, FormatRelativeTime, FormatTime }\n"
    }
  ]
}
