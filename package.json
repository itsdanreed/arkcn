{
  "name": "arkcn-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --deny-warnings && node scripts/check-quotes.mjs && node scripts/check-ark-parts.mjs && node scripts/check-polymorphism.mjs && npm run -s format:check",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,mjs}\" \"docs/src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,ts,tsx}\" \"{packages/*,docs}/*.{json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,mjs}\" \"docs/src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,ts,tsx}\" \"{packages/*,docs}/*.{json,md}\" \"*.{json,md}\"",
    "check": "npm run -s build:registry && npm run -s typecheck && npm run -s lint && npm run -s test:contracts && npm run -s test:components && npm run -s test:cli && npm run -s test:packages && npm run -s test:native",
    "test:components": "node scripts/test-components.mjs",
    "build:registry": "npm run -s build:tokens && node scripts/build-registry.mjs",
    "test:cli": "node scripts/test-cli.mjs",
    "docs:dev": "vite --config docs/vite.config.ts --port 5180",
    "docs:build": "npm run -s build:registry && vite build --config docs/vite.config.ts && node scripts/docs-routes.mjs",
    "docs:preview": "vite preview --config docs/vite.config.ts --port 5181",
    "test:contracts": "node scripts/check-public-contracts.mjs && tsc -p scripts/type-tests/tsconfig.json --noEmit",
    "test:packages": "node scripts/test-packages.mjs",
    "test:native": "node scripts/test-native.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "audit:check": "node scripts/style-audit-integrity.mjs",
    "audit:prepare": "node scripts/prepare-style-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "^19.2.8",
    "typescript": "~6.0.2"
  }
}
